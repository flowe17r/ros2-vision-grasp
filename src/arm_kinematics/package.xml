<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arm_kinematics</name>
  <version>0.1.0</version>
  <description>KDL forward/inverse kinematics services for the 6-axis arm.</description>
  <maintainer email="rainbowch1@163.com">chenzhihuang</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>arm_interfaces</depend>
  <depend>kdl_parser</depend>
  <build_depend>liborocos-kdl-dev</build_depend>
  <exec_depend>liborocos-kdl</exec_depend>
  <depend>urdf</depend>
  <depend>eigen</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
