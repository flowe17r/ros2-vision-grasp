<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="vg_arm">

  <!-- 手臂涂装避开红/绿/蓝检测区间，防止机身被当成方块 -->
  <xacro:arg name="controllers_file" default="$(find arm_description)/config/controllers.yaml"/>

  <material name="metal">
    <color rgba="0.78 0.80 0.84 1.0"/>
  </material>
  <material name="accent">
    <color rgba="0.85 0.42 0.08 1.0"/>
  </material>
  <material name="rubber">
    <color rgba="0.10 0.10 0.10 1.0"/>
  </material>

  <!-- 固定在 Gazebo 世界坐标，防止机械臂在重力下倾倒 -->
  <link name="world"/>
  <joint name="world_fixed" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
  </joint>

  <!-- base -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.10"/>
      </geometry>
      <material name="metal"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.10"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.00343" ixy="0" ixz="0" iyy="0.00343" iyz="0" izz="0.00486"/>
    </inertial>
  </link>

  <!-- joint 1: base yaw -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="30.0" velocity="1.5"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>
  <link name="link1">
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.12"/>
      </geometry>
      <material name="accent"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.12"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.001565" ixy="0" ixz="0" iyy="0.001565" iyz="0" izz="0.001210"/>
    </inertial>
  </link>

  <!-- joint 2: shoulder pitch -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="30.0" velocity="1.5"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>
  <link name="link2">
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.30"/>
      </geometry>
      <material name="metal"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.30"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.007708" ixy="0" ixz="0" iyy="0.007708" iyz="0" izz="0.000417"/>
    </inertial>
  </link>

  <!-- joint 3: elbow pitch -->
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 0.30" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="2.5" effort="30.0" velocity="1.5"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>
  <link name="link3">
    <visual>
      <origin xyz="0 0 0.11" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.22"/>
      </geometry>
      <material name="accent"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.11" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.22"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.11" rpy="0 0 0"/>
      <mass value="0.7"/>
      <inertia ixx="0.002917" ixy="0" ixz="0" iyy="0.002917" iyz="0" izz="0.000187"/>
    </inertial>
  </link>

  <!-- joint 4: wrist roll -->
  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0 0 0.22" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="10.0" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.02"/>
  </joint>
  <link name="link4">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.06"/>
      </geometry>
      <material name="metal"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.000243" ixy="0" ixz="0" iyy="0.000243" iyz="0" izz="0.000245"/>
    </inertial>
  </link>

  <!-- joint 5: wrist pitch（±3.1 才能让夹爪朝下抓取） -->
  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.1" upper="3.1" effort="10.0" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.02"/>
  </joint>
  <link name="link5">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.032" length="0.05"/>
      </geometry>
      <material name="accent"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.032" length="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.000139" ixy="0" ixz="0" iyy="0.000139" iyz="0" izz="0.000154"/>
    </inertial>
  </link>

  <!-- joint 6: wrist roll -->
  <joint name="joint6" type="revolute">
    <parent link="link5"/>
    <child link="tool0"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="5.0" velocity="2.5"/>
    <dynamics damping="0.1" friction="0.02"/>
  </joint>
  <link name="tool0">
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.03"/>
      </geometry>
      <material name="metal"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.0000953" ixy="0" ixz="0" iyy="0.0000953" iyz="0" izz="0.000153"/>
    </inertial>
  </link>

  <!-- gripper base -->
  <joint name="gripper_mount" type="fixed">
    <parent link="tool0"/>
    <child link="gripper_base"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
  </joint>
  <link name="gripper_base">
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.10 0.03"/>
      </geometry>
      <material name="rubber"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.10 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.000145" ixy="0" ixz="0" iyy="0.000225" iyz="0" izz="0.000325"/>
    </inertial>
  </link>

  <!-- left finger：闭合时间隙 40 mm，张开 15 mm 时间隙 70 mm，可夹 50 mm 方块 -->
  <joint name="finger_left_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="finger_left"/>
    <origin xyz="0 0.026 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.03" effort="10.0" velocity="0.05"/>
  </joint>
  <link name="finger_left">
    <visual>
      <origin xyz="0 0 -0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.012 0.06"/>
      </geometry>
      <material name="metal"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.012 0.06"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.03" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.0000156" ixy="0" ixz="0" iyy="0.0000159" iyz="0" izz="0.00000154"/>
    </inertial>
  </link>

  <!-- right finger -->
  <joint name="finger_right_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="finger_right"/>
    <origin xyz="0 -0.026 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.03" effort="10.0" velocity="0.05"/>
  </joint>
  <link name="finger_right">
    <visual>
      <origin xyz="0 0 -0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.012 0.06"/>
      </geometry>
      <material name="metal"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.012 0.06"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.03" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.0000156" ixy="0" ixz="0" iyy="0.0000159" iyz="0" izz="0.00000154"/>
    </inertial>
  </link>

  <!-- TCP：两指中点，位于夹爪基座下方 35 mm；抓取时对准方块中心 -->
  <joint name="tcp_joint" type="fixed">
    <parent link="gripper_base"/>
    <child link="tcp"/>
    <origin xyz="0 0 -0.035" rpy="0 0 0"/>
  </joint>
  <link name="tcp">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>

  <!-- 指垫摩擦：摩擦不足会导致抬升时方块滑落 -->
  <gazebo reference="finger_left">
    <mu1>5.0</mu1>
    <mu2>5.0</mu2>
  </gazebo>
  <gazebo reference="finger_right">
    <mu1>5.0</mu1>
    <mu2>5.0</mu2>
  </gazebo>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="joint1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint3">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint4">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint5">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint6">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="finger_left_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="finger_right_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_file)</parameters>
    </plugin>
  </gazebo>

</robot>
